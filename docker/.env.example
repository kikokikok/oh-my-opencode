# ═══════════════════════════════════════════════════════════════════════════════
# Oh-My-OpenCode Docker Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and customize as needed:
#   cp .env.example .env
#
# DEFAULT SETUP: Copilot API on host port 4141 (no API keys needed!)
# Just run: npx copilot-api@latest start --port 4141
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# OPENAI API CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# OpenAI-compatible API base URL
# Default: Copilot API on host (http://host.docker.internal:4141/v1)
# For LiteLLM: http://litellm:4141/v1
# OPENAI_API_BASE=http://host.docker.internal:4141/v1

# API Key (only needed for LiteLLM or direct OpenAI)
# For Copilot API: leave as "dummy" or any value
OPENAI_API_KEY=dummy

# ═══════════════════════════════════════════════════════════════════════════════
# LITELLM CONFIGURATION (only if using LiteLLM profile)
# ═══════════════════════════════════════════════════════════════════════════════

# Anthropic API Key (for Claude models via LiteLLM)
# Get your key at: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google API Key (for Gemini models via LiteLLM)
# Get your key at: https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=your-google-key-here

# LiteLLM master key for admin operations
# Generate a secure key: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-omo-litellm-change-me

# LiteLLM port (default: 4141)
LITELLM_PORT=4141

# ═══════════════════════════════════════════════════════════════════════════════
# LETTA CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Letta server port (default: 8283)
LETTA_PORT=8283

# Letta environment (DEVELOPMENT or PRODUCTION)
LETTA_ENVIRONMENT=PRODUCTION

# PostgreSQL credentials for Letta
LETTA_POSTGRES_USER=letta
LETTA_POSTGRES_PASSWORD=letta
LETTA_POSTGRES_DB=letta

# ═══════════════════════════════════════════════════════════════════════════════
# COPILOT API IN DOCKER (only if using --profile copilot)
# ═══════════════════════════════════════════════════════════════════════════════

# Copilot API port when running in Docker (default: 60062)
COPILOT_API_PORT=60062
